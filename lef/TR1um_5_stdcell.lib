        pin(A) { direction: input; capacitance: 1.0; }
        pin(B) { direction: input; capacitance: 1.0; }
        pin(C) { direction: input; capacitance: 1.0; }
        pin(Y) {
            direction: output;
            function: "(A+B+C)'";
            timing() {
                related_pin: "A B C";
                timing_sense: negative_unate;
                cell_rise(delay_template) { values("0.14, 0.14", "0.14, 0.14"); }
                cell_fall(delay_template) { values("0.14, 0.14", "0.14, 0.14"); }
                rise_transition(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
