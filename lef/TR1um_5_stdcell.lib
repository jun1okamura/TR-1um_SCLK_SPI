                cell_rise(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
                cell_fall(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
                rise_transition(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
                fall_transition(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
            }
        }
    }
    cell(AND2_X1) {
        area: 2;
        pin(A) { direction: input; capacitance: 1.0; }
        pin(B) { direction: input; capacitance: 1.0; }
        pin(Y) {
            direction: output;
            function: "(A*B)";
            timing() {
                related_pin: "A B";
                timing_sense: positive_unate;
                cell_rise(delay_template) { values("0.12, 0.12", "0.12, 0.12"); }
                cell_fall(delay_template) { values("0.12, 0.12", "0.12, 0.12"); }
                rise_transition(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
