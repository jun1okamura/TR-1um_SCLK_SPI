                cell_rise(delay_template) { values("0.8, 0.8", "0.8, 0.8"); }
                cell_fall(delay_template) { values("0.8, 0.8", "0.8, 0.8"); }
                rise_transition(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
