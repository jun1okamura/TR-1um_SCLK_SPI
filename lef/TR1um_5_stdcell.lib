    cell(MUX2) {
        area: 3;
        pin(A) { direction: input; capacitance: 1.0; }
        pin(B) { direction: input; capacitance: 1.0; }
        pin(S) { direction: input; capacitance: 1.0; }
        pin(Y) {
            direction: output;
            function: "(S*B)+(S'*A)";
            timing() {
                related_pin: "A B S";
                timing_sense: non_unate;
                cell_rise(delay_template) { values("0.2, 0.2", "0.2, 0.2"); }
