    cell(XOR2) {
        area: 3;
        pin(A) { direction: input; capacitance: 1.0; }
        pin(B) { direction: input; capacitance: 1.0; }
        pin(Y) {
            direction: output;
            function: "(A^B)";
            timing() {
                related_pin: "A B";
                timing_sense: non_unate;
                cell_rise(delay_template) { values("0.18, 0.18", "0.18, 0.18"); }
                cell_fall(delay_template) { values("0.18, 0.18", "0.18, 0.18"); }
                rise_transition(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
                fall_transition(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
            }
        }
    }
    cell(XNOR2) {
        area: 3;
