                fall_transition(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
            }
        }
    }
    cell(DFFRB) {
        area: 8;
        ff(IQ, IQN) {
            clocked_on : "CK";
            next_state : "D";
            clear    : "!RSTB";
        }
        pin(CK)  { direction: input; clock: true; capacitance: 1.0; }
        pin(D)   { direction: input; capacitance: 1.0; }
        pin(RSTB) { direction: input; capacitance: 1.0; }
        pin(Q) {
            direction: output; function: "IQ";
            timing() {
                related_pin: "CK";
                timing_sense: non_unate;
                cell_rise(delay_template) { values("0.25, 0.25", "0.25, 0.25"); }
                cell_fall(delay_template) { values("0.25, 0.25", "0.25, 0.25"); }
                rise_transition(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
                fall_transition(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
            }
            timing() {
                related_pin: "RSTB";
                timing_sense: non_unate;
                cell_rise(delay_template) { values("0.2, 0.2", "0.2, 0.2"); }
                cell_fall(delay_template) { values("0.2, 0.2", "0.2, 0.2"); }
                rise_transition(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
                fall_transition(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
            }
        }
        pin(QB) {
            direction: output; function: "IQN";
            timing() {
                related_pin: "CK";
                timing_sense: non_unate;
                cell_rise(delay_template) { values("0.25, 0.25", "0.25, 0.25"); }
                cell_fall(delay_template) { values("0.25, 0.25", "0.25, 0.25"); }
                rise_transition(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
                fall_transition(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
            }
            timing() {
                related_pin: "RSTB";
                timing_sense: non_unate;
                cell_rise(delay_template) { values("0.2, 0.2", "0.2, 0.2"); }
                cell_fall(delay_template) { values("0.2, 0.2", "0.2, 0.2"); }
                rise_transition(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
                fall_transition(delay_template) { values("0.1, 0.1", "0.1, 0.1"); }
            }
        }
    }
    cell(DFFS) {
        area: 8;
        ff(IQ, IQN) {
            clocked_on : "CK";
            next_state : "D";
            preset   : "SET";
        }
        pin(CK)  { direction: input; clock: true; capacitance: 1.0; }
        pin(D)   { direction: input; capacitance: 1.0; }
        pin(SET) { direction: input; capacitance: 1.0; }
        pin(Q) {
            direction: output; function: "IQ";
