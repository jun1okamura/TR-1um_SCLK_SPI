# ───────────────────────────────────────────────────────────────
# A. どの設計でも道具が作るもの（3 設計で同一。差分が出たら片方が古い）
#    U83、2026-09-17。ここを直すときは 3 つとも直すこと。
# ★ 行末にコメントを付けない。.gitignore は行末 # をコメントとして扱わず、
#   パターンの一部にする（2026-09-17 に char/pack*/ で実際に踏んだ）。
# ───────────────────────────────────────────────────────────────
.DS_Store
TR-1um/
# Cowork の受け渡し用フォルダ（リポジトリの正本ではない）
Claude outputs/
__pycache__/
*.pyc
# TB が吐く波形（iverilog の $dumpfile がリポジトリ直下に落とす）
*.vcd
# iverilog の中間物（syn/syn.sh が TB を回すたびに作り直す）
#   .synlog と SYN_RESULTS.txt は**回した記録なので追跡する**（3 設計とも）
out/*.ivl
out/*.vvp
# GDS を上書きしたときに残る退避。**リポジトリの道具は作らない**
#   （出どころ未特定。KLayout アプリか同期ツール。git に版があるので捨ててよい）
*.~backup
# P&R の受け渡し用 tarball（cloud <-> Mac）。中身は展開済み
.pnr_stage/

# apr/drc_pdk.py が作る DRC レポート
*_drc.lyrdb
DRC_error.lyrdb
src/*.lyrdb
# apr/lvs_pdk.py が作る LVS レポートと抽出物
*.lvsdb
src/*.lvsdb
src/*.extracted
# apr/drc_pdk.py --mdp が起こすマスクデータ（5 MB / 作り直せる）
src/*_mdp.gds
mdp/
# char/mklib.py が .lib を作り直すときに取る退避
lef/*.lib.bak

# apr/route.py（step6）の内部チェックポイント。毎回作り直す
layout/step6/
# チップの LVS 抽出（apr/klayout_extract.py が作る）
layout/chip/*.extracted
# チップ ngspice の生成物
# ★ models.spice は回した機械の PDK 絶対パスを 1 行持つ。機械依存（U24）
layout/chip/simulation/*.raw.csv
layout/chip/simulation/*.log
layout/chip/simulation/models.spice
layout/chip/simulation/*_sim.spice
layout/chip/simulation/*_extracted.spice

# ───────────────────────────────────────────────────────────────
# B. この設計だけ
# ───────────────────────────────────────────────────────────────
layout/sim/
ngspice/b3v33check.log
# scripts/gen_chip_tb.py が作る ngspice 入力
layout/chip/simulation/tb_chip_spi.spice
